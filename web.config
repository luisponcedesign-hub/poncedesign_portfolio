<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- =====================================================================
         SECURITY HEADERS
         No modules required. Safe to deploy on its own.
         ===================================================================== -->
    <httpProtocol>
      <customHeaders>

        <!-- Stop leaking the ASP.NET version. -->
        <remove name="X-Powered-By" />

        <!-- HSTS: force HTTPS for a year, including subdomains.
             NOTE: browsers ignore this header when sent over plain HTTP,
             so it only takes effect once the redirect below is live.
             NOTE: this is sticky. Once a visitor receives it, their browser
             refuses plain HTTP to this domain for a year, and every
             subdomain of poncedesign.com must then serve valid HTTPS.
             To test cautiously first, set max-age=300, verify, then raise.
             'preload' is deliberately omitted - it is very hard to undo. -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />

        <!-- Don't let browsers guess content types. -->
        <add name="X-Content-Type-Options" value="nosniff" />

        <!-- Clickjacking. frame-ancestors in the CSP below is the modern
             equivalent; this covers older browsers. -->
        <add name="X-Frame-Options" value="DENY" />

        <!-- Send only the origin to other sites, nothing on downgrade. -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />

        <!-- Turn off device APIs this site never uses. -->
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), interest-cohort=()" />

        <!-- Content Security Policy.
             'unsafe-inline' is required by the markup as it stands today:
               - script-src: the inline `className += ' js'` one-liner in every
                 page head, plus the application/ld+json blocks (JSON-LD is
                 covered by script-src even though it never executes).
               - style-src:  43 inline style="..." attributes across the pages.
             Even with 'unsafe-inline', 'self' still blocks the thing that
             actually matters - loading script from an attacker's origin.
             Upgrade path: have scripts/build.py emit CSP hashes for the
             inline blocks, then drop 'unsafe-inline' from script-src. -->
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests" />

      </customHeaders>
    </httpProtocol>

    <!-- Drop the "Server: Microsoft-IIS/10.0" banner. IIS 10.0+ only.
         The live response shows "Microsoft-IIS/10.0, IIS188P", which means
         something upstream is appending to it - this may only strip the
         first half. Harmless either way. -->
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>

    <!-- =====================================================================
         REDIRECTS
         REQUIRES the IIS URL Rewrite module. If the host does not have it
         installed, the whole site returns HTTP 500 and you must delete this
         <rewrite> block. Test immediately after uploading.
         ===================================================================== -->
    <rewrite>
      <rules>

        <!-- HTTP -> HTTPS. Safe to enable now. -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- www -> apex, matching the canonical tags, sitemap.xml and
             robots.txt, which all declare https://poncedesign.com/ .

             !! DO NOT ENABLE THIS YET !!
             As of this writing the apex resolves to leftover Adobe Portfolio
             infrastructure and serves a cert error plus a 404, while www is
             the only working hostname. Enabling this rule first would redirect
             your entire live site into that broken endpoint.

             Enable ONLY after the apex A record points at 66.96.146.50 and
             https://poncedesign.com/ loads correctly in a browser.

        <rule name="Redirect www to apex" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.poncedesign\.com$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://poncedesign.com/{R:1}" redirectType="Permanent" />
        </rule>
        -->

      </rules>
    </rewrite>

  </system.webServer>
</configuration>
